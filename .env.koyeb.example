APP_NAME=SmartLocker API
APP_ENV=production
API_V1_PREFIX=/api/v1
DEBUG=false
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg://postgres.your-project:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DATA_ENCRYPTION_KEY=replace-with-long-random-encryption-string

SESSION_COOKIE_NAME=smartlocker_session
SESSION_PERSIST_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

TRAVELLINE_AUTH_URL=https://partner.tlintegration.com/auth/token
TRAVELLINE_API_BASE_URL=https://partner.tlintegration.com
TRAVELLINE_TIMEOUT_SECONDS=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-mail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-mail@gmail.com
SMTP_USE_TLS=true
