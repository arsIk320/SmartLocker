APP_NAME=SmartLocker API
APP_ENV=production
API_V1_PREFIX=/api/v1
DEBUG=false
HOST=0.0.0.0
PORT=8000

POSTGRES_DB=smartlocker
POSTGRES_USER=smartlocker
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://smartlocker:change-this-password@db:5432/smartlocker

JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DATA_ENCRYPTION_KEY=change-this-long-random-string

SESSION_COOKIE_NAME=smartlocker_session
SESSION_PERSIST_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

TRAVELLINE_AUTH_URL=https://partner.tlintegration.com/auth/token
TRAVELLINE_API_BASE_URL=https://partner.tlintegration.com
TRAVELLINE_TIMEOUT_SECONDS=20

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-mail@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-mail@gmail.com
SMTP_USE_TLS=true
