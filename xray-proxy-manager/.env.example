XRAY_MANAGER_DOMAIN=vpn.example.com
XRAY_MANAGER_SERVER_PORT=443
XRAY_MANAGER_UI_HOST=127.0.0.1
XRAY_MANAGER_UI_PORT=8080
XRAY_MANAGER_DATABASE_URL=sqlite:////etc/xray/manager.sqlite3
XRAY_MANAGER_XRAY_CONFIG_PATH=/etc/xray/config.json
XRAY_MANAGER_DOMAINS_PATH=/etc/xray/domains.json
XRAY_MANAGER_CERT_PATH=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
XRAY_MANAGER_KEY_PATH=/etc/letsencrypt/live/vpn.example.com/privkey.pem
XRAY_MANAGER_ACCESS_LOG_PATH=/var/log/xray/access.log
XRAY_MANAGER_ERROR_LOG_PATH=/var/log/xray/error.log
XRAY_MANAGER_REMARK_PREFIX=smartlocker
XRAY_MANAGER_XRAY_SERVICE=xray
