APP_NAME=SmartLocker API
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true
HOST=127.0.0.1
PORT=8000

DATABASE_URL=sqlite:///./smartlocker.db
SMARTLOCKER_API_BASE_URL=

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DATA_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
DATA_ENCRYPTION_KEY_LEGACY=
FACE_MATCH_DISTANCE_THRESHOLD=0.92

SESSION_COOKIE_NAME=smartlocker_session
SESSION_PERSIST_DAYS=30
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

ADMIN_EMAIL=admin@smartlocker.local
ADMIN_PASSWORD=Admin123!

TRAVELLINE_AUTH_URL=https://partner.tlintegration.com/auth/token
TRAVELLINE_API_BASE_URL=https://partner.tlintegration.com
TRAVELLINE_CLIENT_ID=
TRAVELLINE_CLIENT_SECRET=
TRAVELLINE_PROPERTY_ID=
TRAVELLINE_TIMEOUT_SECONDS=20

EMAIL_DELIVERY_MODE=console
EMAIL_FROM_NAME=SmartLocker
SMTP_FROM_EMAIL=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_USE_TLS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_KEY=replace-with-a-random-shared-secret
TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8000
TELEGRAM_BOT_API_INTERNAL_HOST=
TELEGRAM_BOT_API_INTERNAL_PORT=
TELEGRAM_BOT_WEBHOOK_BASE_URL=
TELEGRAM_BOT_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=
